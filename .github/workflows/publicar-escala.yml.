
name: Publicar Escala

on:
  release:
    types: [published]

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: escala-pages
  cancel-in-progress: false

jobs:
  publicar:
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deploy.outputs.page_url }}

    steps:
      - name: Obter ficheiro da versão
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          mkdir -p pacote public
          gh release download "${{ github.event.release.tag_name }}" \
            --repo "${{ github.repository }}" \
            --pattern "Escala.zip" \
            --dir pacote

      - name: Preparar aplicação
        run: |
          python3 - <<'PY'
          import zipfile
          from pathlib import Path

          archive = Path("pacote/Escala.zip")
          destination = Path("public")

          with zipfile.ZipFile(archive) as z:
              for info in z.infolist():
                  path = Path(info.filename)
                  if path.is_absolute() or ".." in path.parts:
                      raise ValueError("Caminho inseguro no ZIP")
                  if ((info.external_attr >> 16) & 0o170000) == 0o120000:
                      raise ValueError("Atalhos não permitidos")
              z.extractall(destination)

          for required in ("index.html", "sw.js",
                           "manifest.webmanifest"):
              if not (destination / required).is_file():
                  raise FileNotFoundError(required)
          PY

      - name: Configurar GitHub Pages
        uses: actions/configure-pages@v5

      - name: Preparar publicação
        uses: actions/upload-pages-artifact@v3
        with:
          path: public

      - name: Publicar aplicação
        id: deploy
        uses: actions/deploy-pages@v4
